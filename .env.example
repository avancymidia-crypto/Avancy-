# ---------------------------------------------------------------------------
# Avancy — configuração
# Copie para .env e ajuste. O .env não vai para o Git.
# ---------------------------------------------------------------------------

PORT=3000

# URL pública do app. Precisa bater EXATAMENTE com o redirect_uri cadastrado
# no painel da Meta. Em produção, o domínio real com https.
PUBLIC_URL=http://localhost:3000

# Assina o cookie de sessão. Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem isto, as sessões caem a cada restart do servidor.
SESSION_SECRET=

# Origem dos dados: "mock" (simulados) ou "instagram" (Graph API real).
DATA_PROVIDER=mock

# ---------------------------------------------------------------------------
# Credenciais da Meta — só necessárias com DATA_PROVIDER=instagram.
# Onde conseguir: developers.facebook.com > seu app > Configurações > Básico
# Passo a passo completo em docs/meta-app-setup.md
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# CORS — só necessário se a interface estiver hospedada em OUTRO domínio
# (por exemplo, um projeto no Lovable consumindo esta API).
# Vazio = o app serve a própria interface e não precisa disto.
# Origens separadas por vírgula, exatas, sem barra no fim.
# Atenção: com isto preenchido o cookie vira SameSite=None, que exige https.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=

# Para onde devolver o usuário depois do login com o Instagram. Só precisa
# definir se a interface estiver noutro domínio E for diferente da primeira
# origem de ALLOWED_ORIGINS. Vazio = volta para a raiz deste servidor.
FRONTEND_URL=
